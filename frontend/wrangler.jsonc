// Cloudflare Workers static assets: serves the built SPA from ./dist.
// Deploy: VITE_API_BASE_URL=https://<backend> npm run build && npx wrangler deploy
{
  "$schema": "https://unpkg.com/wrangler@4.159.0/config-schema.json",
  "name": "opportunity-reality-check",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
